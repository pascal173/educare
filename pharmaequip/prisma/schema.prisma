generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  price       Float
  bulkPrice   Float?
  stock       Int      @default(50)
  nafdac      String?
  image       String
  description String
  specs       String
  createdAt   DateTime @default(now())
}

model Order {
  id            String      @id
  date          DateTime    @default(now())
  customer      String
  email         String
  phone         String
  total         Float
  status        String
  reference     String
  paymentMethod String
  deliveryType  String
  address       String?
  city          String?
  state         String?
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id              String   @id
  date            DateTime @default(now())
  customer        String
  email           String
  phone           String?
  company         String?
  interestedItems String?
  message         String
  status          String   @default("Quote Request")
  createdAt       DateTime @default(now())
}
